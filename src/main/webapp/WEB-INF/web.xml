<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>QuizMaster Web Application</display-name>

    <!-- ============================================== -->
    <!-- 1. FILTERS                                     -->
    <!-- ============================================== -->

    <!-- Encoding Filter (Enforce UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.quizmaster.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.quizmaster.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/quiz-take/*</url-pattern>
        <url-pattern>/quiz-manage/*</url-pattern>
        <url-pattern>/quiz-lab/*</url-pattern>
        <url-pattern>/profile/*</url-pattern>
    </filter-mapping>

    <!-- Admin Authorization Filter -->
    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.quizmaster.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ============================================== -->
    <!-- 2. SERVLETS & SERVLET MAPPINGS                 -->
    <!-- ============================================== -->

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
    </servlet-mapping>

    <!-- Quiz Browsing Servlet -->
    <servlet>
        <servlet-name>QuizServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.QuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuizServlet</servlet-name>
        <url-pattern>/quiz</url-pattern>
    </servlet-mapping>

    <!-- Quiz Authoring & Management Servlet -->
    <servlet>
        <servlet-name>QuizManageServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.QuizManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuizManageServlet</servlet-name>
        <url-pattern>/quiz-manage</url-pattern>
    </servlet-mapping>

    <!-- Quiz Lab Studio Servlet -->
    <servlet>
        <servlet-name>QuizLabServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.QuizLabServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuizLabServlet</servlet-name>
        <url-pattern>/quiz-lab</url-pattern>
    </servlet-mapping>

    <!-- Take Quiz / Arena Servlet -->
    <servlet>
        <servlet-name>TakeQuizServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.TakeQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TakeQuizServlet</servlet-name>
        <url-pattern>/quiz-take</url-pattern>
    </servlet-mapping>

    <!-- Leaderboard Servlet -->
    <servlet>
        <servlet-name>LeaderboardServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.LeaderboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaderboardServlet</servlet-name>
        <url-pattern>/leaderboard</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Admin Dashboard Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.quizmaster.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <!-- ============================================== -->
    <!-- 3. SESSION & WELCOME FILES                     -->
    <!-- ============================================== -->

    <session-config>
        <session-timeout>45</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
